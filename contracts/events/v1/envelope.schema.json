    "eventId",
    "aggregateId",
    "correlationId",
    "causationId",
    "eventType",
    "aggregateType",
    "source",
    "aggregateVersion",
    "eventSequence",
    "occurredAt",
    "recordedAt",
    "payload"
  ],
  "properties": {
