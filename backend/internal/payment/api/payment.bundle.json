{
  "components": {
    "headers": {
      "shared_CorrelationID": {
        "description": "Correlation identifier echoed on all responses.",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/contracts_common_v1_types__defs_ID"
        }
      }
    },
    "parameters": {
      "shared_CorrelationID": {
        "description": "Use a valid supplied UUIDv4 or generate one when absent; echo on every response.",
        "in": "header",
        "name": "X-Correlation-ID",
        "schema": {
          "$ref": "#/components/schemas/contracts_common_v1_types__defs_ID"
        }
      },
      "shared_IdempotencyKey": {
        "description": "Required for durable mutation commands; scope by channel and authenticated customer/actor.",
        "in": "header",
        "name": "Idempotency-Key",
        "required": true,
        "schema": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        }
      }
    },
    "responses": {
      "shared_Error": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/shared_ErrorEnvelope"
            }
          }
        },
        "description": "Safe error envelope; transport errors do not establish payment business outcomes.",
        "headers": {
          "X-Correlation-ID": {
            "$ref": "#/components/headers/shared_CorrelationID"
          }
        }
      }
    },
    "schemas": {
      "Claim": {
        "additionalProperties": false,
        "properties": {
          "claimId": {
            "$ref": "#/components/schemas/contracts_common_v1_types__defs_ID"
          },
          "claimedAt": {
            "$ref": "#/components/schemas/contracts_common_v1_types__defs_Timestamp"
          },
          "kind": {
            "enum": [
              "SUBMISSION",
              "CANCELLATION"
            ],
            "type": "string"
          }
        },
        "required": [
          "kind",
          "claimId",
          "claimedAt"
        ],
        "type": "object"
      },
      "CommandReceipt": {
        "additionalProperties": false,
        "properties": {
          "commandId": {
            "$ref": "#/components/schemas/contracts_common_v1_types__defs_ID"
          },
          "commandType": {
            "enum": [
              "SUBMIT_PAYMENT"
            ],
            "type": "string"
          },
          "committedVersion": {
            "$ref": "#/components/schemas/contracts_common_v1_types__defs_PositiveSequence"
          },
          "correlationId": {
            "$ref": "#/components/schemas/contracts_common_v1_types__defs_ID"
          },
          "paymentId": {
            "$ref": "#/components/schemas/contracts_common_v1_types__defs_ID"
          },
          "recordedAt": {
            "$ref": "#/components/schemas/contracts_common_v1_types__defs_Timestamp"
          },
          "status": {
            "enum": [
              "COMMITTED"
            ],
            "type": "string"
          }
        },
        "required": [
          "commandId",
          "commandType",
          "paymentId",
          "status",
          "committedVersion",
          "correlationId",
          "recordedAt"
        ],
        "type": "object"
      },
      "Creditor": {
        "additionalProperties": false,
        "description": "BOOK_TRANSFER names a GTB accountId; other products name accountNumber, bankIdentifier and country. The payment domain enforces these product rules (ADR 0009).",
        "properties": {
          "accountId": {
            "$ref": "#/components/schemas/contracts_common_v1_types__defs_ID"
          },
          "accountNumber": {
            "description": "External account; required for other products.",
            "pattern": "^[0-9A-Za-z-]{1,34}$",
            "type": "string"
          },
          "bankIdentifier": {
            "description": "Domestic bank code or BIC (BIC for CROSS_BORDER).",
            "pattern": "^[A-Z0-9]{4,11}$",
            "type": "string"
          },
          "country": {
            "description": "SG for DOMESTIC_INSTANT/RTGS; not SG for CROSS_BORDER.",
            "pattern": "^[A-Z]{2}$",
            "type": "string"
          },
          "name": {
            "maxLength": 140,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "Dispatch": {
        "additionalProperties": false,
        "properties": {
          "attempts": {
            "minimum": 0,
            "type": "integer"
          },
          "status": {
            "description": "PENDING means no workflow has been started yet; it never implies acceptance.",
            "enum": [
              "PENDING",
              "STARTED"
            ],
            "type": "string"
          },
          "updatedAt": {
            "$ref": "#/components/schemas/contracts_common_v1_types__defs_Timestamp"
          },
          "workflowId": {
            "pattern": "^payment/[0-9a-f-]{36}$",
            "type": "string"
          }
        },
        "required": [
          "workflowId",
          "status",
          "attempts",
          "updatedAt"
        ],
        "type": "object"
      },
      "ExecutionOutcome": {
        "enum": [
          "NOT_SUBMITTED",
          "PENDING",
          "CONFIRMED_SUCCESS",
          "CONFIRMED_FAILURE",
          "UNKNOWN"
        ],
        "type": "string"
      },
      "LifecycleState": {
        "enum": [
          "RECEIVED",
          "VALIDATING",
          "SCHEDULED",
          "REQUIRES_REVIEW",
          "ACCEPTED",
          "EXECUTING",
          "COMPLETED",
          "REJECTED",
          "CANCELLED",
          "RETURNED"
        ],
        "type": "string"
      },
      "PaymentReceipt": {
        "additionalProperties": false,
        "properties": {
          "commandId": {
            "$ref": "#/components/schemas/contracts_common_v1_types__defs_ID"
          },
          "dispatch": {
            "$ref": "#/components/schemas/Dispatch"
          },
          "executionOutcome": {
            "$ref": "#/components/schemas/ExecutionOutcome"
          },
          "lifecycleState": {
            "$ref": "#/components/schemas/LifecycleState"
          },
          "paymentId": {
            "$ref": "#/components/schemas/contracts_common_v1_types__defs_ID"
          },
          "receiptVersion": {
            "$ref": "#/components/schemas/contracts_common_v1_types__defs_PositiveSequence"
          },
          "receivedAt": {
            "$ref": "#/components/schemas/contracts_common_v1_types__defs_Timestamp"
          }
        },
        "required": [
          "paymentId",
          "commandId",
          "receiptVersion",
          "lifecycleState",
          "executionOutcome",
          "dispatch",
          "receivedAt"
        ],
        "type": "object"
      },
      "PaymentRecord": {
        "additionalProperties": false,
        "properties": {
          "claim": {
            "$ref": "#/components/schemas/Claim"
          },
          "customerId": {
            "$ref": "#/components/schemas/contracts_common_v1_types__defs_ID"
          },
          "dispatch": {
            "$ref": "#/components/schemas/Dispatch"
          },
          "executionOutcome": {
            "$ref": "#/components/schemas/ExecutionOutcome"
          },
          "executionWorkflowId": {
            "pattern": "^execution/[0-9a-f-]{36}/[a-z-]+$",
            "type": "string"
          },
          "instruction": {
            "$ref": "#/components/schemas/PaymentRequest"
          },
          "lifecycleState": {
            "$ref": "#/components/schemas/LifecycleState"
          },
          "paymentId": {
            "$ref": "#/components/schemas/contracts_common_v1_types__defs_ID"
          },
          "receivedAt": {
            "$ref": "#/components/schemas/contracts_common_v1_types__defs_Timestamp"
          },
          "updatedAt": {
            "$ref": "#/components/schemas/contracts_common_v1_types__defs_Timestamp"
          },
          "version": {
            "$ref": "#/components/schemas/contracts_common_v1_types__defs_PositiveSequence"
          }
        },
        "required": [
          "paymentId",
          "customerId",
          "version",
          "lifecycleState",
          "executionOutcome",
          "instruction",
          "dispatch",
          "receivedAt",
          "updatedAt"
        ],
        "type": "object"
      },
      "PaymentRequest": {
        "additionalProperties": false,
        "properties": {
          "amount": {
            "$ref": "#/components/schemas/PositiveMoney"
          },
          "creditor": {
            "$ref": "#/components/schemas/Creditor"
          },
          "customerId": {
            "$ref": "#/components/schemas/contracts_common_v1_types__defs_ID"
          },
          "debtorAccountId": {
            "$ref": "#/components/schemas/contracts_common_v1_types__defs_ID"
          },
          "product": {
            "$ref": "#/components/schemas/Product"
          },
          "reference": {
            "maxLength": 140,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "customerId",
          "product",
          "debtorAccountId",
          "amount",
          "creditor"
        ],
        "type": "object"
      },
      "PositiveMoney": {
        "allOf": [
          {
            "$ref": "#/components/schemas/contracts_common_v1_types__defs_Money"
          },
          {
            "properties": {
              "amountMinor": {
                "pattern": "^[1-9][0-9]{0,17}$",
                "type": "string"
              },
              "currency": {
                "enum": [
                  "SGD",
                  "USD"
                ],
                "type": "string"
              }
            }
          }
        ]
      },
      "Product": {
        "enum": [
          "BOOK_TRANSFER",
          "DOMESTIC_INSTANT",
          "RTGS",
          "CROSS_BORDER"
        ],
        "type": "string"
      },
      "contracts_common_v1_types__defs_Error": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "INVALID_REQUEST",
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "NOT_FOUND",
              "CONFLICT",
              "RATE_LIMITED",
              "DEPENDENCY_UNAVAILABLE",
              "INTERNAL_ERROR"
            ]
          },
          "message": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "type": "object"
      },
      "contracts_common_v1_types__defs_ID": {
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      },
      "contracts_common_v1_types__defs_Money": {
        "additionalProperties": false,
        "properties": {
          "amountMinor": {
            "pattern": "^(0|-?[1-9][0-9]{0,17})$",
            "type": "string"
          },
          "currency": {
            "enum": [
              "SGD",
              "USD"
            ]
          }
        },
        "required": [
          "amountMinor",
          "currency"
        ],
        "type": "object"
      },
      "contracts_common_v1_types__defs_PositiveSequence": {
        "pattern": "^[1-9][0-9]{0,17}$",
        "type": "string"
      },
      "contracts_common_v1_types__defs_Timestamp": {
        "format": "date-time",
        "not": {
          "anyOf": [
            {
              "pattern": "^0000-"
            },
            {
              "pattern": "^0001-01-01T00:00:00(\\.0{1,9})?Z$"
            }
          ]
        },
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
        "type": "string"
      },
      "shared_ErrorEnvelope": {
        "additionalProperties": false,
        "properties": {
          "correlationId": {
            "$ref": "#/components/schemas/contracts_common_v1_types__defs_ID"
          },
          "error": {
            "$ref": "#/components/schemas/contracts_common_v1_types__defs_Error"
          }
        },
        "required": [
          "error",
          "correlationId"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "B02 customer payment command boundary. `202` means the instruction, idempotency record, audit entry, PaymentReceived event and workflow-start dispatch intent committed together: durably received, never accepted or completed. Repeating the same Idempotency-Key for the same customer with the same payload replays the original receipt; a different payload returns 409. Receipt reads come from the authoritative command store and show pending dispatch even before projections exist.",
    "title": "GTB payment commands",
    "version": "1.0.0"
  },
  "openapi": "3.1.1",
  "paths": {
    "/api/v1/commands/{commandId}": {
      "get": {
        "operationId": "getCommand",
        "parameters": [
          {
            "in": "path",
            "name": "commandId",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/contracts_common_v1_types__defs_ID"
            }
          },
          {
            "$ref": "#/components/parameters/shared_CorrelationID"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandReceipt"
                }
              }
            },
            "description": "Command status from the command store.",
            "headers": {
              "X-Correlation-ID": {
                "$ref": "#/components/headers/shared_CorrelationID"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/shared_Error"
          },
          "401": {
            "$ref": "#/components/responses/shared_Error"
          },
          "403": {
            "$ref": "#/components/responses/shared_Error"
          },
          "404": {
            "$ref": "#/components/responses/shared_Error"
          },
          "500": {
            "$ref": "#/components/responses/shared_Error"
          },
          "503": {
            "$ref": "#/components/responses/shared_Error"
          }
        },
        "summary": "Read a durable command receipt."
      }
    },
    "/api/v1/payments": {
      "post": {
        "description": "Requires the `customer` role and `customerId` in the token's customer scope. The debtor account must belong to that customer (checked with Core Banking); unknown and foreign accounts are both denied with 403. A 503 is retryable only with the same Idempotency-Key and payload.",
        "operationId": "submitPayment",
        "parameters": [
          {
            "$ref": "#/components/parameters/shared_IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/shared_CorrelationID"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentReceipt"
                }
              }
            },
            "description": "Receipt committed now or replayed from the original request.",
            "headers": {
              "Idempotent-Replayed": {
                "description": "`true` when the original receipt was replayed.",
                "required": true,
                "schema": {
                  "type": "boolean"
                }
              },
              "X-Correlation-ID": {
                "$ref": "#/components/headers/shared_CorrelationID"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/shared_Error"
          },
          "401": {
            "$ref": "#/components/responses/shared_Error"
          },
          "403": {
            "$ref": "#/components/responses/shared_Error"
          },
          "409": {
            "$ref": "#/components/responses/shared_Error"
          },
          "500": {
            "$ref": "#/components/responses/shared_Error"
          },
          "503": {
            "$ref": "#/components/responses/shared_Error"
          }
        },
        "summary": "Durably receive a customer payment instruction."
      }
    },
    "/api/v1/payments/{paymentId}/receipt": {
      "get": {
        "description": "Customers see only their own customers' payments; ops_viewer, investigator, approver and auditor may read any receipt.",
        "operationId": "getPaymentReceipt",
        "parameters": [
          {
            "in": "path",
            "name": "paymentId",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/contracts_common_v1_types__defs_ID"
            }
          },
          {
            "$ref": "#/components/parameters/shared_CorrelationID"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentRecord"
                }
              }
            },
            "description": "Current aggregate, immutable instruction and dispatch state.",
            "headers": {
              "X-Correlation-ID": {
                "$ref": "#/components/headers/shared_CorrelationID"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/shared_Error"
          },
          "401": {
            "$ref": "#/components/responses/shared_Error"
          },
          "403": {
            "$ref": "#/components/responses/shared_Error"
          },
          "404": {
            "$ref": "#/components/responses/shared_Error"
          },
          "500": {
            "$ref": "#/components/responses/shared_Error"
          },
          "503": {
            "$ref": "#/components/responses/shared_Error"
          }
        },
        "summary": "Read the authoritative command-store record of a payment."
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "servers": [
    {
      "url": "http://127.0.0.1:8082"
    }
  ]
}
